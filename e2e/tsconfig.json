{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist/",
    // ES2022 for the standard `new Error(message, { cause })`, which is how a rethrow keeps the read
    // that actually failed instead of describing it. Node 22 runs this and nothing here is emitted,
    // so the target only decides which library declarations a typecheck admits.
    "target": "ES2022",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
