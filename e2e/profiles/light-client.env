# light-client: the segment bytes come from a gateway, the way a viewer with no node reads them.
#
# The control for `in-browser.env`, which is the default profile. The byte source is the only
# condition that differs, and E2E_EXPECT_SEGMENT_S differs BECAUSE of it: the two byte sources
# measured opposite optima on segment length, so a run of the pair is two sittings against two
# stages rather than one arm and its control. See the segment block below before reconciling
# anything. Everything else here is deliberately identical, including what is left unset.
#
# A profile holds only what makes a run the run it is. Where the stack lives is the deployment's to
# say, so no host, no port, no ssh target and no compose profile belongs here. A value the operator
# already exported always beats a value in this file, so one run can be steered without editing it.
#
# ## Left unset on purpose, and each absence is a decision
#
#   BROWSER_TARGET_LATENCY_S   The shipped client's own live-sync target stands. Pinning it lower is
#                              a measurement condition rather than a product default, and a rebuffer
#                              count taken at a pin cannot be read as one the product delivers.
#   ABR_ENABLED, ABR_LADDER    What the deployment transcodes is the deployment's to state. A run
#                              declares what it expects to cover, below, and the preflight refuses
#                              the mismatch rather than measuring one and reporting the other.
#   HLS_FRAGMENT               What the stage cuts at is the deployment's to state, for the same
#                              reason. This run declares the length it NEEDS, below, and the
#                              preflight refuses a stage producing another one.
#
# Measurement sittings exist to refine the values in this file. When a sitting settles a number, the
# number moves here and the next run inherits it.

# Where the player fetches segment bytes. Only `weeb3` and `gateway` parse, and a third spelling is
# refused rather than read as the default.
BROWSER_FETCH_BACKEND=gateway

# This run covers the ABR ladder, and stops before the first frame if the deployment has no ladder
# to cover. Spelled `true` and never the word `ladder`: the accepted spellings are `ABR_ENABLED`'s
# own, so an operator setting both does not have to remember two vocabularies.
E2E_EXPECT_ABR=true

# A real browser watches the broadcast under this profile, so the viewer suites run rather than
# skip. Spelled the way E2E_EXPECT_ABR is spelled, for the same reason. A deliberately browser-less
# rerun says E2E_EXPECT_BROWSER=false in the environment, which beats this file by design.
E2E_EXPECT_BROWSER=true

# How long a segment this run needs the stage to publish, in seconds.
#
# ⛔⛔⛔ THIS NUMBER IS DELIBERATELY DIFFERENT FROM in-browser.env's, AND THAT IS THE FINDING.
# Do not reconcile the two. The byte source is the only condition that differs between the pair, and
# the two byte sources measured OPPOSITE optima on segment length, so one number cannot serve both.
#
# 0.5s here, because that is where the gateway path measures best: 1.55s of capture-to-fetchable
# latency against 3.88s at 2s, over 21 funded arms. The difference is publisher-side by
# construction, since a segment cannot be uploaded until it is complete, so a longer segment is
# inside the number rather than a property of the fetch.
#
# The opposite pull is in in-browser.env: an in-tab weeb-3 node holds 1.000x of realtime on 2s
# segments and 0.426x on 0.5s, because it admits about one segment per second whatever its peer
# count. Both figures are from the sibling repo swarm-stream-loadlab, measured 2026-08-16, in
# docs/measurements/2026-08-16-a-stock-tab-holds-realtime-on-two-second-segments.md, and the trade
# is carried unresolved as its open product question Q23.
#
# ⚠️ The two were never measured on one stage, so nothing here ranks the paths against each other.
# Each number says only where its own path measured best.
E2E_EXPECT_SEGMENT_S=0.5
