# in-browser: the segment bytes come from a Swarm node running in the viewer's own tab.
#
# This is the DEFAULT profile, because the in-tab node is the thing this project exists to measure.
# `light-client.env` is its control: the same broadcast, the same ladder, read through a gateway.
#
# A profile holds only what makes a run the run it is. Where the stack lives is the deployment's to
# say, so no host, no port, no ssh target and no compose profile belongs here. A value the operator
# already exported always beats a value in this file, so one run can be steered without editing it.
#
# ## Left unset on purpose, and each absence is a decision
#
#   BROWSER_TARGET_LATENCY_S   The shipped client's own live-sync target stands. Pinning it lower is
#                              a measurement condition rather than a product default, and a rebuffer
#                              count taken at a pin cannot be read as one the product delivers.
#   ABR_ENABLED, ABR_LADDER    What the deployment transcodes is the deployment's to state. A run
#                              declares what it expects to cover, below, and the preflight refuses
#                              the mismatch rather than measuring one and reporting the other.
#   HLS_FRAGMENT               What the stage cuts at is the deployment's to state, for the same
#                              reason. This run declares the length it NEEDS, below, and the
#                              preflight refuses a stage producing another one.
#
# Measurement sittings exist to refine the values in this file. When a sitting settles a number, the
# number moves here and the next run inherits it.

# Where the player fetches segment bytes. Only `weeb3` and `gateway` parse, and a third spelling is
# refused rather than read as the default.
BROWSER_FETCH_BACKEND=weeb3

# This run covers the ABR ladder, and stops before the first frame if the deployment has no ladder
# to cover. Spelled `true` and never the word `ladder`: the accepted spellings are `ABR_ENABLED`'s
# own, so an operator setting both does not have to remember two vocabularies.
E2E_EXPECT_ABR=true

# A real browser watches the broadcast under this profile, so the viewer suites run rather than
# skip. Spelled the way E2E_EXPECT_ABR is spelled, for the same reason. A deliberately browser-less
# rerun says E2E_EXPECT_BROWSER=false in the environment, which beats this file by design.
E2E_EXPECT_BROWSER=true

# How long a segment this run needs the stage to publish, in seconds.
#
# ⛔⛔⛔ THIS NUMBER IS DELIBERATELY DIFFERENT FROM light-client.env's, AND THAT IS THE FINDING.
# Do not reconcile the two. The byte source is the only condition that differs between the pair, and
# the two byte sources measured OPPOSITE optima on segment length, so one number cannot serve both.
#
# 2s here, because an in-tab weeb-3 node cannot sustain anything shorter. Measured 2026-08-16 by the
# sibling repo swarm-stream-loadlab, in
# docs/measurements/2026-08-16-a-stock-tab-holds-realtime-on-two-second-segments.md, and carried as
# the open product question Q23 in its docs/spec/product-spec.md:
#
#   segment length            0.5s        2s
#   sustained playback rate   0.426x      1.000x
#   buffer held ahead         0.5-3.5s    ~90s
#   arms                      1           2
#
# The mechanism is arithmetic and no amount of tuning moves it: weeb-3 admits about one segment per
# second whatever its peer count, so a 0.5s profile needs two admissions a second against a ceiling
# near one and falls behind for as long as the tab is open. Adding peers cannot help, because peers
# were never the constraint.
#
# ⛔ What this cost us. The latbench stage published 0.5s and this profile ran against it: live
# in-tab readings sat at 0.35 to 0.68 of realtime with a 44ms buffer, which is that law and not a
# client defect. suites/preflight/segment-length.test.ts now refuses that pairing before the first
# frame, and names the one knob that fixes it. That stage moved to 1.0s on 2026-09-01, so the
# mismatch is smaller and the preflight still refuses it: deploy the stage at 2.0s to run this
# profile, exactly as before.
#
# ✅ **This profile was never exposed to the announcement ceiling that broke light-client.** SRS
# announces each closed segment once per rung, so a four-rung ladder asks for `rungs / HLS_FRAGMENT`
# a second: 8.0/s at 0.5s, which is above the ~6.7/s SRS was measured sustaining, against 2.0/s here.
# 2s segments sit at under a third of the ceiling, which is why the 1080p rung died on light-client
# and never on this profile. See the block above `HLS_FRAGMENT` in `engines/srs/entrypoint.sh`.
#
# ⚠️ "Holds realtime" is sustained retrieval throughput and NOT live. Both loadlab arms were in the
# archive regime, the 2s one about 80 minutes behind the live edge. Nothing here says 2s segments
# put an in-tab viewer at the live edge.
E2E_EXPECT_SEGMENT_S=2
