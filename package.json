{
  "name": "swarm-hls-stream",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "build:uploader": "pnpm --filter @swarm-hls-stream/stream-uploader build",
    "build:client": "pnpm --filter @swarm-hls-stream/client build",
    "client:start": "pnpm --filter @swarm-hls-stream/client dev",
    "uploader:start": "pnpm --filter @swarm-hls-stream/stream-uploader start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "stamp:setup": "tsx packages/cli/src/index.ts stamp-setup",
    "stamp:buy": "tsx packages/cli/src/index.ts stamp-buy",
    "stamp:check": "tsx packages/cli/src/index.ts stamp-check",
    "node:status": "tsx packages/cli/src/index.ts node-status",
    "node:addresses": "tsx packages/cli/src/index.ts node-addresses",
    "node:wallets": "tsx packages/cli/src/index.ts node-wallets",
    "srs:host": "cd engines/srs && docker compose -f docker-compose.yml -f docker-compose.host.yml up -d ",
    "srs:local": "cd engines/srs && docker compose -f docker-compose.yml -f docker-compose.local.yml up -d",
    "srs:down": "cd engines/srs && docker compose down",
    "srs:logs": "cd engines/srs && docker compose logs -f",
    "ome:host": "cd engines/ome && docker compose -f docker-compose.yml -f docker-compose.host.yml up -d",
    "ome:local": "cd engines/ome && docker compose -f docker-compose.yml -f docker-compose.local.yml up -d",
    "ome:down": "cd engines/ome && docker compose down",
    "ome:logs": "cd engines/ome && docker compose logs -f",
    "e2e:smoke": "pnpm --filter @swarm-hls-stream/e2e test:e2e:smoke",
    "e2e:preflight": "pnpm --filter @swarm-hls-stream/e2e test:e2e:preflight",
    "e2e:run": "pnpm --filter @swarm-hls-stream/e2e test:e2e",
    "bench:latency": "pnpm --filter @swarm-hls-stream/e2e bench:latency",
    "bench:longrun": "pnpm --filter @swarm-hls-stream/e2e bench:longrun",
    "browser:selfcheck": "pnpm --filter @swarm-hls-stream/e2e browser:selfcheck",
    "browser:watch": "pnpm --filter @swarm-hls-stream/e2e browser:watch",
    "browser:crash": "pnpm --filter @swarm-hls-stream/e2e browser:crash",
    "browser:quality": "pnpm --filter @swarm-hls-stream/e2e browser:quality",
    "browser:rung-outage": "pnpm --filter @swarm-hls-stream/e2e browser:rung-outage",
    "browser:buffer-sweep": "pnpm --filter @swarm-hls-stream/e2e browser:buffer-sweep",
    "browser:arm-order": "pnpm --filter @swarm-hls-stream/e2e browser:arm-order",
    "browser:gateway-check": "pnpm --filter @swarm-hls-stream/e2e browser:gateway-check",
    "browser:fetch-backend-check": "pnpm --filter @swarm-hls-stream/e2e browser:fetch-backend-check",
    "browser:byte-source-order": "pnpm --filter @swarm-hls-stream/e2e browser:byte-source-order",
    "audit:check": "tsx packages/audit-gate/src/index.ts",
    "mutate": "stryker run",
    "mutate:client": "stryker run stryker.client.config.json",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && git ls-files -z | xargs -0 -r npx prettier --check --ignore-unknown",
    "gate:facts": "tsx packages/gate-facts/src/index.ts",
    "shellcheck": "docker run --rm -v \"$PWD:/mnt\" -w /mnt koalaman/shellcheck@sha256:bb596a0d169b85ddd81d8b6d3a2ff6d5baf5fca10b97f575ebc647c3dff62b3d --severity=style --format=gcc deploy/scripts/*.sh nodes/*.sh engines/*/*.sh e2e/*.sh",
    "bench:sweep-report": "pnpm --filter @swarm-hls-stream/e2e bench:sweep-report",
    "probe:ahead": "pnpm --filter @swarm-hls-stream/e2e probe:ahead",
    "browser:vod": "pnpm --filter @swarm-hls-stream/e2e browser:vod",
    "make:recording": "pnpm --filter @swarm-hls-stream/e2e make:recording",
    "browser:weeb3-native": "pnpm --filter @swarm-hls-stream/e2e browser:weeb3-native",
    "browser:viewer-order": "pnpm --filter @swarm-hls-stream/e2e browser:viewer-order",
    "browser:in-tab-throttle-probe": "pnpm --filter @swarm-hls-stream/e2e browser:in-tab-throttle-probe"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@stryker-mutator/core": "9.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^2.8.8",
    "tsx": "^4.23.1"
  },
  "pnpm": {
    "overrides": {
      "axios": "^0.33.0",
      "body-parser": "^2.3.0",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "brace-expansion@5": "^5.0.8",
      "fast-uri@3": "^3.1.4",
      "follow-redirects": "^1.16.0",
      "form-data": "^4.0.6",
      "immutable": "^5.1.8",
      "js-yaml@4": "^4.3.1",
      "minimatch@9": "^9.0.7",
      "nanoid@3": "3.3.18",
      "postcss": "^8.5.18",
      "qs": "^6.15.2",
      "ws": "^8.21.0"
    }
  }
}
