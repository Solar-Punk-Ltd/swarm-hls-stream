{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "command",
  "commandRunner": {
    "command": "./packages/client/node_modules/.bin/vitest run --root packages/client --reporter=dot --exclude 'test/bundle.test.ts' > .stryker-test-output.log 2>&1"
  },
  "coverageAnalysis": "off",
  "mutate": ["packages/client/src/**/*.{ts,tsx}", "!packages/client/src/**/*.d.ts"],
  "reporters": ["clear-text", "progress-append-only", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation-client.json"
  },
  "clearTextReporter": {
    "allowColor": false,
    "maxTestsToLog": 0
  },
  "concurrency": 4,
  "timeoutMS": 30000,
  "timeoutFactor": 2,
  "disableTypeChecks": true,
  "tempDirName": ".stryker-tmp"
}
