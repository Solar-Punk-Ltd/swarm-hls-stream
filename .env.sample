# =====================================================
# Single .env for the entire monorepo
# =====================================================
# Used by both packages (local dev) and Docker deployment.
# Copy to .env and fill in the required values.
#
# Engine-specific vars live next to each engine in engines/<name>/.env,
# loaded automatically for the engine selected via ENGINE below.
# Copy from the samples (setup.sh does this for engines enabled in
# deploy/config.json):
#   engines/srs/.env.sample  -> engines/srs/.env
#   engines/ome/.env.sample  -> engines/ome/.env

# === Required ===

STAMP=
STAMP_AMOUNT=10000000000
STAMP_DEPTH=20
STAMP_IMMUTABLE=false
STREAM_KEY=
STREAM_LIST_TOPIC=swarm-stream

# Bearer token for every gated route: /stream/start, /stream/segment, /stream/stop, /stream/status
# and /metrics. GET /health is the only route outside the gate, so a healthcheck or probe can read it.
# Required, with no unauthenticated mode, because every accepted segment spends postage stamp money,
# so an open write endpoint drains the batch of whoever deployed it. Minimum 32 characters.
# Generate one with:  openssl rand -hex 32
API_AUTH_TOKEN=

# Master secret every stream's publish key derives from, so a broadcaster can prove the stream they
# are publishing is theirs. See SEC-28 and deploy/scripts/publish-key.sh.
#
# Left empty on purpose, and empty means publisher authentication is OFF, which is the opposite of
# what an empty API_AUTH_TOKEN or SRS_WEBHOOK_TOKEN means. Those sit between two services one
# operator configures together. This one sits between the deployment and its broadcasters, who each
# have to be issued a key first, so filling it in refuses every publisher who does not present one.
#
# Issue the keys before you set it:  ./deploy/scripts/publish-key.sh <app>/<stream>
# Generate the secret with:          openssl rand -hex 32
# Minimum 32 characters. Rotating it invalidates every key at once, which is the only revocation
# there is.
PUBLISH_KEY_SECRET=

# === Stream Uploader ===

BEE_URL=http://localhost:1633

# One Bee node per ABR rung, as `rung@url<batch>`, space separated. Unset — the default —
# means one node for everything, which is BEE_URL and STAMP above.
#
# Split them because postage batches drain in proportion to bitrate: across the four-rung ladder
# 1080p burns roughly seven times the bytes of 360p, so batches of equal depth expire hours apart.
# One node per rung turns a batch running out into one rung going quiet and ABR stepping down,
# rather than the whole stage stopping. Each node also brings its own chequebook and its own crash
# domain, for the same reason.
#
# Every rung in ABR_LADDER must appear here and nothing else may, or the uploader refuses to start:
# a rung with no node of its own would quietly spend a batch sized for a different bitrate. Requires
# ABR_ENABLED=true, since with no ladder there is nothing to map onto.
#
# The stream catalog and each ladder's master playlist go through the *lowest* rung's node — it has
# the longest-lived batch, and those two feeds are the only addresses a viewer needs to open a stage.
# The batch is bracketed rather than introduced by a `#`, because `#` opens a comment here: an
# unquoted value would be truncated at the first one and the batch ids silently lost. The older
# `#` form is still accepted for a config already written that way.
# BEE_PUBLISHERS=360p@http://localhost:1633<batchid> 480p@http://localhost:1643<batchid> 720p@http://localhost:1653<batchid> 1080p@http://localhost:1663<batchid>
BEE_PUBLISHERS=

# === ABR ladder ===
#
# The three knobs below are read by the stream-uploader *and* by the engine, and
# `deploy/docker-compose.yml` interpolates both services' copies from this file. So this is where a
# Docker deployment sets them: a value in `engines/srs/.env` reaches the uploader's own loader but
# never reaches compose's interpolation, which is how a knob ends up looking configured while every
# container keeps its compiled default.
#
# `engines/srs/.env.sample` carries the full rung-by-rung documentation, plus the encoder settings
# (ABR_FPS, ABR_PRESET, ABR_VBV_SECONDS and the rest) that only SRS reads. Left empty here, each
# falls back to the same default on both sides, so an empty value is not a different configuration.
ABR_ENABLED=false
ABR_LADDER=
ABR_VHOST=abr

API_PORT=3000
STATE_DIR=./state
MAX_QUEUE_SIZE=100
RECOVERY_TIMEOUT=60000
SEGMENT_STALL_MS=30000
SEGMENT_DEDUP_WINDOW=10000
# How long a live stream may receive nothing before it is finalized as an orphan, for the case where
# an engine dies without sending on_unpublish. Deliberately the same 60s as RECOVERY_TIMEOUT rather
# than SEGMENT_STALL_MS, which is a health *reporting* threshold at half this: ending a broadcast on
# that would kill streams that recover.
ORPHAN_REAP_MS=60000

# Erasure-coding parity on segment uploads (0 = off, 1 = the previous default).
#
# Parity is durability insurance, and a live stream pays for it twice: once on upload, and again by
# every viewer, because the extra chunks widen the retrieval fan-out that dominates how long a
# segment takes to arrive. A segment that outlives its playlist window helps nobody, so for live
# the insurance mostly buys nothing. Leave it on for VOD-shaped workloads.
SEGMENT_REDUNDANCY=1

# Engine plugin: srs | ome | (empty for generic API only)
# For ome, also enable the "ome" service in deploy/config.json (disabled by default).
ENGINE=srs

# === Client ===

# Bee node URL for reading streams (proxied in dev via /bee).
# In the dockerized client this is ignored — the build args set it to "/bee"
# and nginx proxies that to the bee-gateway service.
VITE_READER_BEE_URL=http://localhost:1633

# Feed owner address derived from STREAM_KEY (hex, no 0x prefix).
# Per-profile: set in .env.<profile> for each viewer build.
VITE_APP_OWNER=

# Feed topic — must match STREAM_LIST_TOPIC above
VITE_APP_RAW_TOPIC=swarm-stream

# Host port for the client container (defaults to 5173).
# With --portSlot=N every default port shifts by N*10 (e.g. slot 4 -> 10044).
CLIENT_PORT=5173

# Override the upstream the dockerized client's nginx proxies /bee/ to.
# Leave it unset unless you are proxying somewhere else entirely. The default already differs by
# network mode, because the client stays on the bridge in both: a bridge deployment reaches the
# gateway at the compose service name `bee-gateway`, and COMPOSE_NETWORK=host reaches it at
# `host.docker.internal`. Setting it to `bee-gateway` under host mode is exactly the failure OPS-25
# was, where nginx cannot resolve the name and the client restart-loops on every deploy.
# CLIENT_BEE_GATEWAY_HOST=
# CLIENT_BEE_GATEWAY_PORT=1733

# === Docker ===

# Set to "host" to run all containers in host network mode (no port mapping).
# Leave empty for default bridge networking with port mapping.
COMPOSE_NETWORK=

# === Bee Nodes (Docker deployment) ===

RPC_ENDPOINT=https://rpc.gnosischain.com
BEE_VERBOSITY=5

# Uploader node
BEE_UPLOADER_API_PORT=1633
BEE_UPLOADER_P2P_PORT=1634
# Set to your server's public IP so peers can connect. Leave empty to auto-detect.
BEE_UPLOADER_NAT_ADDR=
BEE_UPLOADER_FULL_NODE=false
BEE_UPLOADER_DATA_DIR=./data/bee-uploader

# Gateway node (optional, ultra-light)
BEE_GATEWAY_API_PORT=1733
BEE_GATEWAY_P2P_PORT=1734
# Set to your server's public IP so peers can connect. Leave empty to auto-detect.
BEE_GATEWAY_NAT_ADDR=
BEE_GATEWAY_DATA_DIR=./data/bee-gateway

# Local chunk cache size in chunks. 0 disables caching (pure pass-through
# gateway); Bee's own default is 1000000 (~4GB). Per-profile: override in .env.<profile>.
BEE_GATEWAY_CACHE_CAPACITY=0

# --- Logging --------------------------------------------------------------
# How much the stream-uploader prints. In rising order of quietness:
#   debug   everything (the default, and what every build before this printed)
#   log     drops debug
#   info    also drops the per-segment lines, one per segment per live stream
#   warn    only warnings and errors
#   error   only errors
#   silent  nothing
# An unrecognized value is reported once and then ignored, so a typo here
# cannot stop the service from starting.
LOG_LEVEL=debug

# Set to "json" for one JSON object per line ({ts, level, msg}), for a log
# shipper. Anything else, including unset, keeps the human-readable format.
LOG_FORMAT=
