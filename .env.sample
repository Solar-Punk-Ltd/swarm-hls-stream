# =====================================================
# Single .env for the entire monorepo
# =====================================================
# Used by both packages (local dev) and Docker deployment.
# Copy to .env and fill in the required values.
#
# Engine-specific vars live next to each engine in engines/<name>/.env,
# loaded automatically for the engine selected via ENGINE below.
# Copy from the samples (setup.sh does this for engines enabled in
# deploy/config.json):
#   engines/srs/.env.sample  -> engines/srs/.env
#   engines/ome/.env.sample  -> engines/ome/.env

# === Required, and the stamp purchase defaults ===
#
# STAMP_AMOUNT, STAMP_DEPTH and STAMP_IMMUTABLE are what `pnpm stamp:setup` buys with, and the CLI
# falls back to exactly these three values when they are unset. STAMP itself is required only when
# BEE_PUBLISHERS is empty, since a pool carries each rung's batch in its own entry.

# Required only when BEE_PUBLISHERS below is empty. A node-per-rung deployment
# leaves this blank: each publisher carries its own batch, and inventing one
# here would be indistinguishable from a real batch until something tried to
# pay with it.
STAMP=
STAMP_AMOUNT=10000000000
STAMP_DEPTH=20
STAMP_IMMUTABLE=false
STREAM_KEY=
STREAM_LIST_TOPIC=swarm-stream

# Bearer token for every gated route: /stream/start, /stream/segment, /stream/stop, /stream/status
# and /metrics. GET /health is the only route outside the gate, so a healthcheck or probe can read it.
# Required, with no unauthenticated mode, because every accepted segment spends postage stamp money,
# so an open write endpoint drains the batch of whoever deployed it. Minimum 32 characters.
# Generate one with:  openssl rand -hex 32
API_AUTH_TOKEN=

# Master secret every stream's publish key derives from, so a broadcaster can prove the stream they
# are publishing is theirs. See SEC-28 and deploy/scripts/publish-key.sh.
#
# Left empty on purpose, and empty means publisher authentication is OFF, which is the opposite of
# what an empty API_AUTH_TOKEN or SRS_WEBHOOK_TOKEN means. Those sit between two services one
# operator configures together. This one sits between the deployment and its broadcasters, who each
# have to be issued a key first, so filling it in refuses every publisher who does not present one.
#
# Issue the keys before you set it:  ./deploy/scripts/publish-key.sh <app>/<stream>
# Generate the secret with:          openssl rand -hex 32
# Minimum 32 characters. Rotating it invalidates every key at once, which is the only revocation
# there is.
PUBLISH_KEY_SECRET=

# === Admin mode ===
#
# Where the admin service lives. Setting ADMIN_API_URL by itself turns admin mode ON. Leaving it
# empty keeps this deployment exactly as it has always been. The uploader mints each
# stream's feed topic and the stream catalog on Swarm is its own to write.
#
# With it set, a stream has to be DECLARED in the admin before anything may publish to it. The admin
# mints the feed topic and the publish key. Each engine resolves the ingest `app/stream` against that
# declaration, refuses any publish that is unannounced or presents the wrong key, and the uploader
# publishes on the declared topic and reports `live` and `vod` back instead of writing the catalog.
#
# ⛔ PUBLISH_KEY_SECRET above is IGNORED in admin mode. The two answer the same question from two
# different sources of truth, so the engine blanks the local secret rather than consulting both.
#
# ABR_ENABLED runs alongside admin mode. The declared topic is then the ladder's MASTER playlist feed
# rather than any one rung's: each rung publishes on a feed topic DERIVED from the group and its own
# rung name, so that feed outlives the session and a restarted rung or a reconnected encoder carries
# on writing the same one with a discontinuity at the seam. Recordings sit back to back on it and the
# entry names the latest, which is why the admin accepts `live` again after `vod`. Each rung reports
# its own record, the admin merges them into `renditions` on its catalog entry and hands the merged
# ladder back, and the uploader writes the master from it. `live` and `vod` are then reported for the
# ladder rather than per rung, and `vod`'s index is the master's. The admin must serve
# POST /api/internal/streams/:id/renditions for this. See the uploader README's "Admin mode".
#
# ⛔ STREAM_KEY has to derive the same address as the admin's FEED_PRIVATE_KEY. The admin's catalog
# entry names that owner and every feed this service writes is signed with STREAM_KEY, so with the two
# apart every viewer resolves a feed nobody wrote. The uploader compares the two at boot against the
# admin's public /api/config and refuses to start on a mismatch. Each publish is checked again against
# its declaration's owner. Admin mode does not bypass Bee readiness. After this check, the uploader
# still waits for its coordinator and runs the configured startup gates before engine connections.
ADMIN_API_URL=

# Bearer token for the admin's internal routes, required whenever ADMIN_API_URL is set. Minimum 32
# characters, the same floor as API_AUTH_TOKEN and SRS_WEBHOOK_TOKEN.
# Generate one with:  openssl rand -hex 32
ADMIN_API_TOKEN=

# === Stream Uploader ===

BEE_URL=http://localhost:1633

# Whether this deployment runs a Bee node of its own, which is what decides whether the BEE_URL above
# is honoured. true means the uploader publishes through the deployment's own `bee-uploader`, and
# `deploy.sh` computes that node's address and overrides BEE_URL with it. false means the deployment
# has no node of its own, so BEE_URL is taken exactly as written here.
#
# The deployment manager writes this into every .env.<profile> it generates, from the profile's own
# service list, and only that list can answer the question: deploy/config.json says what the checkout
# is configured for rather than what a given profile is made of, and the service filter of a single
# `deploy.sh` run says only what that run was asked to bring up.
#
# Rarely set by hand. Left out entirely, as here, `deploy.sh` decides the way it always did, from
# deploy/config.json, so a hand-run deploy needs nothing added. Set it only on a deployment that
# names an external Bee node in BEE_URL and is deployed without the manager. Anything other than
# true or false is refused rather than read as "decide as before", because a typo that fell through
# would look exactly like the key working.
# LOCAL_BEE_UPLOADER=false

# One Bee node per ABR rung, as `rung@url<batch>`, space separated. Unset — the default —
# means one node for everything, which is BEE_URL and STAMP above.
#
# Split them because postage batches drain in proportion to bitrate: across the four-rung ladder
# 1080p burns roughly seven times the bytes of 360p, so batches of equal depth expire hours apart.
# One node per rung turns a batch running out into one rung going quiet and ABR stepping down,
# rather than the whole stage stopping. Each node also brings its own chequebook and its own crash
# domain, for the same reason.
#
# Every rung in ABR_LADDER must appear here and nothing else may, or the uploader refuses to start:
# a rung with no node of its own would quietly spend a batch sized for a different bitrate. Requires
# ABR_ENABLED=true, since with no ladder there is nothing to map onto.
#
# The stream catalog and each ladder's master playlist go through the *lowest* rung's node — it has
# the longest-lived batch, and those two feeds are the only addresses a viewer needs to open a stage.
# The batch is bracketed rather than introduced by a `#`, because `#` opens a comment here: an
# unquoted value would be truncated at the first one and the batch ids silently lost. The older
# `#` form is still accepted for a config already written that way.
#
# Generate it rather than typing it: `deploy/scripts/bee-publishers.sh --profile=<p> --portSlot=<n>`
# asks each rung's node which batch it holds, refuses one that is too full or too near expiry, and
# with `--write` puts the line here. A batch id is 64 hex characters and it is live state, so a
# hand-copied one is a truncated paste or a stale value waiting to happen, and both arrive as a
# failed upload mid-broadcast.
# BEE_PUBLISHERS=360p@http://localhost:1633<batchid> 480p@http://localhost:1643<batchid> 720p@http://localhost:1653<batchid> 1080p@http://localhost:1663<batchid>
BEE_PUBLISHERS=

# --- Per-rung Bee nodes ---
#
# The nodes BEE_PUBLISHERS points at. Disabled by default in deploy/config.json's absence, because
# each is a wallet, a chequebook and a postage batch to fund, and a single-rendition deployment needs
# none of them. `bee-uploader` above is the 360p rung as well as the shared default.
#
# ⛔ Their ports open a SECOND DECADE, 1100x, because the 1000x block has no digit left and the port
# slot rule is `base + slot*10` with a unique last digit per service. See PORT_VARS in
# deploy/scripts/_lib.sh, including the note on where the two blocks would meet.
#
# ⛔⛔ These nodes HOLD FUNDS, so unlike deploy/scripts/unfunded-gateway.sh's probe node their
# `password` file is not "a credential that protects nothing". Losing it loses the wallet. Create
# each one in the password manager and place it, rather than generating it on the host.
# BEE_RUNG_480P_API_PORT=11001
# BEE_RUNG_480P_P2P_PORT=11002
# BEE_RUNG_720P_API_PORT=11003
# BEE_RUNG_720P_P2P_PORT=11004
# BEE_RUNG_1080P_API_PORT=11005
# BEE_RUNG_1080P_P2P_PORT=11006
#
# Where each rung node keeps its data, its wallet and the password file above. Unset, each falls back
# to BEE_DATA_ROOT below and then to ./data/bee-uploader-<rung>, so moving all five nodes onto
# another disk is BEE_DATA_ROOT alone and moving one of them is its own line here. `deploy.sh`
# creates and seeds the uploader's and the gateway's data directories and not these three, which is
# the other half of the password note above: place each of these yourself before the first deploy.
# BEE_RUNG_480P_DATA_DIR=./data/bee-uploader-480p
# BEE_RUNG_720P_DATA_DIR=./data/bee-uploader-720p
# BEE_RUNG_1080P_DATA_DIR=./data/bee-uploader-1080p
#
# ⛔ The same API bind pair the uploader and gateway nodes carry further down, and it matters most
# here, because these are the three nodes holding funds. Which of the two applies is decided by
# COMPOSE_NETWORK, and the block beginning "Bee's HTTP API has no authentication of any kind"
# explains both. Left empty, as below, each rung API answers on every interface.
# BEE_RUNG_480P_API_BIND=
# BEE_RUNG_480P_API_LISTEN=
# BEE_RUNG_720P_API_BIND=
# BEE_RUNG_720P_API_LISTEN=
# BEE_RUNG_1080P_API_BIND=
# BEE_RUNG_1080P_API_LISTEN=
#
# Light or full mode for all three at once, unlike BEE_UPLOADER_FULL_NODE, which is one node's own.
# BEE_RUNG_FULL_NODE=false

# How long the uploader waits for one HTTP request to any Bee node above before giving up on it.
#
# ⛔ A node that accepts the connection and then answers nothing is the case this exists for. bee-js
# reads an unset timeout as no timeout, so such a node used to hold the rung's upload queue open for
# ever, and on the lowest rung it held the stream catalog for the whole stage. Nothing timed out and
# nothing in the logs said why the stage had gone quiet.
#
# The default is derived rather than chosen: every bee call sits inside a retry window, the shortest
# of those is 10s, and 4s leaves room for two whole attempts inside it. Raising it past ~4.8s leaves
# the retry with nowhere to retry.
BEE_REQUEST_TIMEOUT_MS=4000

# What the two startup gates below do about a node they cannot clear, and how long each of their
# reads may take.
#
# ⛔ The owner ruled on 2026-09-17 that the uploader starts whatever the chequebook says, and that a
# postage batch is not the same risk: a batch that is full or expired fails every write while the
# broadcast looks live to the room, the viewer and the catalog, and the recording it was meant to buy
# is never kept. So there are three values and the default is the two gates ruled apart:
#
#   chequebook-warn  the chequebook gate warns and starts. The postage gate refuses a batch the node
#                    ANSWERED about and warns about one it could not read at all. The default.
#   warn             both gates warn and start.
#   refuse           both gates refuse, which is what every boot did before that date.
#
# A refusal stops the service and docker restarts it into the same refusal until someone reads the
# log, and under the default it is only ever about a node that ANSWERED with a reading the gate will
# not accept. That is true of the postage gate too since decision 7 b of 2026-09-17: a batch it could
# not read at all, a timeout, a 5xx or an answer with no readable fields, is warned about and the
# uploader starts, because a rung whose node is not talking has said nothing about any batch. Under
# refuse that reading stops the boot again. A node that does not answer at all never makes the service
# exit, under any of the three, which is decision D16 of the same day and is not something a
# deployment can turn off. The coordinator, the node the catalog goes through, is waited for under
# every one of them, and under refuse so is any rung node that does not answer. Under chequebook-warn
# and warn a rung node other than the coordinator that does not answer is warned about and the
# uploader starts, degraded, with that rung named on /health as start_gate_warned.
#
# The timeout is deliberately not BEE_REQUEST_TIMEOUT_MS above. A chequebook balance and a postage
# batch are answered off the chain rather than out of the node's own memory, so they are the slowest
# reads this service makes, and that 4000ms is derived from the retry windows of the upload loop and
# describes neither. Lending it to them is what held a live uploader in a restart loop on 2026-09-16
# against a pool address that had no node behind it. Ten minutes is the ceiling, which catches the
# two-zero slip: 2000000 is 33 minutes for one read and over four hours for a warn pass over four
# nodes, and it is refused. The one-zero slip is not caught, since 200000 is under the ceiling and is
# a setting somebody could mean, and it costs about 26 minutes a pass.
#
# A gate that warns reads every node before it reports, so one boot names every rung to fix, and what
# it found is on /health as `start_gate_warned` until the service is restarted. That leaves the
# container reporting unhealthy, which is the point: a warning nobody can find is the same as no
# warning at all. `deploy/scripts/assert-started.sh` prints it during a deploy and does not refuse.
UPLOADER_START_GATES=chequebook-warn
START_GATE_TIMEOUT_MS=20000

# The chequebook floor, in BZZ, that every Bee node above must hold AVAILABLE for the uploader to
# call it funded. A dry chequebook is silent: the node answers /health while every paid push stalls,
# so every boot reads this rather than finding out at the first segment. Below the floor the uploader
# warns and starts, and UPLOADER_START_GATES=refuse above is what makes it a refusal again. 0 accepts
# any balance and still reports a chequebook that cannot be read at all.
CHEQUEBOOK_MIN_BZZ=0.5

# How much time a postage batch must have left, and how full it may be, for the uploader to call it
# usable. Checked per rung against the batch named in BEE_PUBLISHERS (or STAMP when unsplit), and
# whether a batch that fails either one stops the start is UPLOADER_START_GATES above.
#
# ⛔ A batch id being well formed says nothing about the batch. BeePublisherPool refuses an id that is
# malformed or does not cover the ladder; these two are the half that asks whether the batch it names
# can still carry anything. A batch that is full or expired fails every upload while the node answers
# normally and the config reads correctly, which is the same silent shape as a dry chequebook.
#
# ⚠️ The ceiling is a ratio rather than a byte figure on purpose: across the shipped ladder 1080p
# burns roughly seven times the bytes of 360p, so no single amount of headroom means the same thing
# on two rungs.
# ⚠️ The floor is twelve hours, the owner's ruling of 2026-09-15. A batch that expires part way
# through a run stops keeping everything stored under it, the whole broadcast and its recording, so
# the floor has to outlast the longest broadcast a deployment books. Half a day covers the 3 to 6
# hour broadcasts booked here and still leaves a two-day batch usable for most of its life. A
# deployment that streams for longer than half a day raises this to cover the run.
STAMP_MIN_TTL_HOURS=12
STAMP_MAX_UTILIZATION=0.9

# === ABR ladder ===
#
# The three knobs below are read by the stream-uploader *and* by the engine, and
# `deploy/docker-compose.yml` interpolates both services' copies from this file. So this is where a
# Docker deployment sets them. Setting one in `engines/srs/.env` is not ignored: `deploy.sh` writes
# every key of the enabled engines' env files into `.env.deploy.<profile>` and hands that to compose
# as a second `--env-file`, so it reaches both services. What it writes there is the value the root
# env settled on, because the engine file is loaded below this one, so a knob named in both places
# takes the root's value and the engine file's copy is what looks configured and does nothing.
#
# `engines/srs/.env.sample` carries the full rung-by-rung documentation, plus the encoder settings
# (ABR_FPS, ABR_PRESET, ABR_VBV_SECONDS and the rest) that only SRS reads. Left empty here, each
# falls back to the same default on both sides, so an empty value is not a different configuration.
ABR_ENABLED=false
ABR_LADDER=
ABR_VHOST=abr

API_PORT=3000
STATE_DIR=./state
MAX_QUEUE_SIZE=100
RECOVERY_TIMEOUT=60000
SEGMENT_STALL_MS=30000
SEGMENT_DEDUP_WINDOW=10000
# Nominal seconds of media per fragment. The SAME variable the engine reads, and the uploader now
# reads it too: a segment within 1% of it is dated as exactly that length, and one outside it by the
# media it really holds. Left unset here so a fresh install takes the measured compose default of 0.5
# on both sides. A pair that disagrees still dates every recording by its media, so the clock is
# right, and everything built on the declared length is not: every #EXT-X-GAP entry is dated and
# sized at a length nothing is cutting, so a lost segment leaves a hole of the wrong size.
# HLS_FRAGMENT=0.5
# The longest a segment may run before SRS closes it without waiting for a keyframe, in seconds.
# SRS's own knob is a ratio of HLS_FRAGMENT, which means the ceiling moved whenever the fragment did:
# the shipped pair was 2.5s and setting the fragment to 2 made it 10s silently. The entrypoint
# derives the ratio from this instead, so this number means what it says. It has to clear the
# publisher's keyframe interval plus the ~0.135s a segment overshoots by, and it can never be below
# HLS_FRAGMENT. Set HLS_AOF_RATIO to drive SRS's ratio directly instead.
# HLS_SEGMENT_MAX=2.5
# How long a live stream may receive nothing before it is finalized as an orphan. Deliberately the
# same 60s as RECOVERY_TIMEOUT rather than SEGMENT_STALL_MS, which is a health *reporting* threshold
# at half this: ending a broadcast on that would kill streams that recover.
#
# ⛔ Since 2026-09-22 this is ALSO the reconnect window, and on the SRS path it is what ends a
# broadcast nothing else ends: an encoder disconnecting no longer finalizes anything, so the session
# is held for this long with no media, and an encoder that comes back inside it resumes the same
# recording with one discontinuity at the seam. POST /stream/stop and the post-crash recovery
# timeout still end a broadcast on their own, immediately, and are not governed by this.
# Raising it holds a dead broadcast live for longer and shows `live` in the admin for longer;
# lowering it splits a broadcaster's session over shorter outages.
ORPHAN_REAP_MS=60000

# Erasure-coding parity on segment uploads (0 = off, 1 = the previous default).
#
# Parity is durability insurance, and a live stream pays for it twice: once on upload, and again by
# every viewer, because the extra chunks widen the retrieval fan-out that dominates how long a
# segment takes to arrive. A segment that outlives its playlist window helps nobody, so for live
# the insurance mostly buys nothing. Leave it on for VOD-shaped workloads.
SEGMENT_REDUNDANCY=1

# Engine plugin: srs | ome | (empty for generic API only)
# For ome, also enable the "ome" service in deploy/config.json (disabled by default).
ENGINE=srs

# === Client ===

# Bee node URL for reading streams (proxied in dev via /bee).
# In the dockerized client this is ignored — the build args set it to "/bee"
# and nginx proxies that to the bee-gateway service.
VITE_READER_BEE_URL=http://localhost:1633

# Feed owner address derived from STREAM_KEY (hex, no 0x prefix).
# Per-profile: set in .env.<profile> for each viewer build.
VITE_APP_OWNER=

# Feed topic — must match STREAM_LIST_TOPIC above
VITE_APP_RAW_TOPIC=swarm-stream

# ⛔ A build arg, and a deployment serving viewers leaves it empty. Set, the bundle publishes the
# hls.js instance, the gateway switch and the fetch backend handle on globalThis, which is how the
# e2e browser drivers move a player's latency target or its byte source between arms of one
# broadcast. Empty, Vite substitutes the flag with a literal and every guarded branch is eliminated,
# which packages/client/test/bundle.test.ts asserts. Baked in at build time, so changing it means
# rebuilding the client image.
VITE_EXPOSE_PLAYER=

# Host port for the client container (defaults to 5173).
# With --portSlot=N every default port shifts by N*10 (e.g. slot 4 -> 10044).
CLIENT_PORT=5173

# Override the upstream the dockerized client's nginx proxies /bee/ to.
# Leave it unset unless you are proxying somewhere else entirely. The default already differs by
# network mode, because the client stays on the bridge in both: a bridge deployment reaches the
# gateway at the compose service name `bee-gateway`, and COMPOSE_NETWORK=host reaches it at
# `host.docker.internal`. Setting it to `bee-gateway` under host mode is exactly the failure OPS-25
# was, where nginx cannot resolve the name and the client restart-loops on every deploy.
# CLIENT_BEE_GATEWAY_HOST=
# CLIENT_BEE_GATEWAY_PORT=1733

# === Engine config file ===

# Run an engine on a config file of your own instead of its template under engines/<engine>/. The
# path of a file on the machine that runs compose, mounted read-only into the container. The
# entrypoint runs the same substitutions on it as on the template, so every *_PLACEHOLDER token you
# keep is filled from the environment (the passphrase, the ports, the webhook token, HLS_FRAGMENT
# and the rest) and every one you drop is simply gone. Empty runs the template, and a path that is
# not a file on that machine is refused rather than fallen back from. Start from a copy of the
# template, and check an SRS file with the engine's own test mode before deploying it. See
# engines/README.md, "Your own config file".
SRS_CONF_FILE=
OME_CONF_FILE=

# === Docker ===

# Set to "host" to run all containers in host network mode (no port mapping).
# Leave empty for default bridge networking with port mapping.
COMPOSE_NETWORK=

# === Bee Nodes (Docker deployment) ===

# The parent directory every node's data lands under when it has no *_DATA_DIR of its own. One
# setting moves all five, and a node that names its own directory ignores it. Paths are resolved by
# the machine running compose, so on a remote target this is a path on that host.
# BEE_DATA_ROOT=./data

# Which blockchain RPC the four publisher nodes talk to, bee-uploader and the three rung nodes. The
# gateway reads BEE_GATEWAY_RPC_ENDPOINT further down instead, and ships with none.
# The default is a public Gnosis endpoint and it rate-limits hard. Measured on the deployment host on
# 2026-09-15, one uploader node took 4568 HTTP 429 answers in two hours and a gateway beside it took
# 795, which stalls the chain listener and is a large part of why a node is slow to become ready.
# Any reachable URL works here. One running on this host is reached as http://host.docker.internal:PORT
# from inside the containers. Deployments already running keep the value they started with until they
# are deployed again.
RPC_ENDPOINT=https://rpc.gnosischain.com
BEE_VERBOSITY=5

# Bee's HTTP API has no authentication of any kind — no token, no password, no restricted mode.
# Reaching it is enough to spend a postage batch, upload arbitrary chunks and write feeds, with the
# node's wallet behind it. Bee's own packaged default is 127.0.0.1:1633 for exactly this reason;
# ours publishes the port instead, so on any host with a public address the API needs one of the
# two knobs below set, and ideally a firewall as well. P2P stays open on every interface either
# way: restricting it would cut the node off from Swarm.
#
# Which knob applies depends on the network mode, and they are not interchangeable:
#
#   bridge (COMPOSE_NETWORK empty)  →  *_API_BIND, the host-side address of the published port.
#                                      The process keeps binding every interface *inside* its own
#                                      namespace, which is what lets the mapping work at all.
#   host   (COMPOSE_NETWORK=host)   →  *_API_LISTEN, the process's own bind address. Published
#                                      ports are ignored entirely in host mode, so *_API_BIND
#                                      does nothing and this is the only thing that binds.
#
# Leaving both empty reproduces the previous behaviour: the API on every interface. That is safe on
# a machine with no public address and nowhere else.
#
# One caveat before setting these on a single-host deployment: the manager reaches each node's API
# through the published port via host.docker.internal, which resolves to the docker bridge address
# rather than to 127.0.0.1. Binding to loopback will cut off stamp management. Bind to the bridge
# address or a private interface, not to 127.0.0.1, wherever the manager has to reach the node.
BEE_UPLOADER_API_BIND=
BEE_UPLOADER_API_LISTEN=
BEE_GATEWAY_API_BIND=
BEE_GATEWAY_API_LISTEN=

# The three HTTP ports the engines publish, and the same question as the four lines above: which
# address a published port answers on. They sit here because this file has no engine port section of
# its own, and the deployment reads them from here. On the engine-only path, `pnpm srs:local` and
# `pnpm ome:local`, the same names are read from engines/srs/.env and engines/ome/.env instead.
#
# SRS's control API on 1985 is the one to think about first. It has no authentication either, and
# GET /api/v1/streams names every live stream as app/stream, which is the id an ingest URL and a
# publish key are built from, while GET /api/v1/clients names every publisher's and every viewer's
# address. SRS's file server on 8080 and OME's HLS port on 8081 serve the segments themselves, so a
# broadcast can be watched straight off the ingest host, bypassing Swarm, the catalog and the viewer.
#
# All three default to 0.0.0.0, every interface, which is what these ports have always done. A host
# with a public address binds them to a private interface or to 127.0.0.1: every documented use of
# the SRS API is a curl run on the host itself. Under COMPOSE_NETWORK=host they do nothing at all,
# exactly as *_API_BIND does nothing there, and the engines have no equivalent of *_API_LISTEN
# because both bind a port rather than an address.
SRS_HTTP_API_BIND=
SRS_HTTP_BIND=
OME_HTTP_BIND=

# Uploader node
BEE_UPLOADER_API_PORT=1633
BEE_UPLOADER_P2P_PORT=1634
# Set to your server's public IP so peers can connect. Leave empty to auto-detect.
BEE_UPLOADER_NAT_ADDR=
BEE_UPLOADER_FULL_NODE=false
BEE_UPLOADER_DATA_DIR=./data/bee-uploader

# Gateway node (optional, ultra-light)
BEE_GATEWAY_API_PORT=1733
BEE_GATEWAY_P2P_PORT=1734
# Set to your server's public IP so peers can connect. Leave empty to auto-detect.
BEE_GATEWAY_NAT_ADDR=
BEE_GATEWAY_DATA_DIR=./data/bee-gateway

# The gateway's mode, and the two keys below are one decision. The endpoint is what puts the node on
# the chain, and swap is what lets it pay peers out of a chequebook. With neither set, which is how
# this file ships, the node is ultra-light: no chain, no chequebook, download only, nothing to fund.
#
# Set both or neither. An endpoint with swap off is a light node that talks to the chain, replays the
# postage contract on every empty data dir and still cannot pay anyone, and swap on with no endpoint
# is refused by bee at startup. A gateway on the chain needs gas and a funded chequebook at the
# address its `/addresses` reports as `chain_address`, both topped up by hand.
#
# A deployment the manager runs does not set these by hand. The manager writes both keys for a
# gateway an operator created on the chain and neither for one created ultra-light. An endpoint of
# your own running on this host is reached as http://host.docker.internal:PORT from the containers.
# BEE_GATEWAY_RPC_ENDPOINT=https://rpc.gnosischain.com
# BEE_GATEWAY_SWAP_ENABLE=true

# Local chunk cache size in chunks. Bee's own default is 1000000 (~4GB) and this deployment ships 0,
# which is neither on nor off.
#
# ⛔ 0 does NOT disable caching. Bee's cache Putter never tests capacity, so chunks enter regardless,
# and eviction fires on every cached chunk asking to drop at least 10,000, which is hard-coded in bee
# with no flag. Measured 2026-08-14: the gateway reported bee_localstore_cache_size -1844 across
# 2,989 eviction rounds while the uploader beside it at bee's default had never evicted once. So the
# cache here is a sawtooth whose phase nothing records, and a reading's exposure to it scales with
# how long the reading took to gather.
#
# ⚠️ Left at 0 because every sitting this project has run was gathered at 0, so moving it breaks
# comparability and restarts the gateway. See docs/bench/the-gateway-cache-is-a-sawtooth-2026-08-14.md
# and the block above the flag in deploy/docker-compose.yml.
# Per-profile: override in .env.<profile>.
BEE_GATEWAY_CACHE_CAPACITY=0

# The flag that does turn the gateway cache off. Bee's own help calls it "enable forwarded content
# caching (default true)", and the default here is bee's, so deployments are unchanged.
#
# ⛔ Set it false for an experiment that needs a cold node on every pass, and read no cache-off
# figure gathered without it. Measured 2026-08-10 at capacity 0, confirmed on the running container:
# a second walk of the same 1000 references moved the same 120 MB with a median of 4ms against 121ms
# on the first, so every arm this project ever labelled cache-off was measured with the cache on.
# BEE_GATEWAY_CACHE_RETRIEVAL=true

# --- Logging --------------------------------------------------------------
# How much the stream-uploader prints. In rising order of quietness:
#   debug   everything (the default, and what every build before this printed)
#   log     drops debug
#   info    also drops the per-segment lines, one per segment per live stream
#   warn    only warnings and errors
#   error   only errors
#   silent  nothing
# An unrecognized value is reported once and then ignored, so a typo here
# cannot stop the service from starting.
LOG_LEVEL=debug

# Set to "json" for one JSON object per line ({ts, level, msg}), for a log
# shipper. Anything else, including unset, keeps the human-readable format.
LOG_FORMAT=
