# === SRS Media Server ===
# Copy to engines/srs/.env — loaded automatically when ENGINE=srs.
# Profile deploys use engines/srs/.env.<profile> (deploy.sh creates it from
# engines/srs/.env on first deploy).

# Segment length in seconds, and the playlist window in seconds. Defaults reproduce the
# previous hardcoded values. Keep the publisher's GOP at or below HLS_FRAGMENT, because SRS
# can only cut on a keyframe and will otherwise emit segments longer than this asks for.
#
# HLS_WINDOW is a duration, not a count, so raising HLS_FRAGMENT alone shrinks the playlist
# depth in segments: 22.5/1.5 is 15 segments, 22.5/6 is under 4. Keep the two proportional.
#
# The player's DEFAULT_HLS_TUNING.liveSyncDuration (10s) is a latency target clamped to the
# playlist window, so it has to stay comfortably inside HLS_WINDOW. Because both are in
# seconds, that stays true as HLS_FRAGMENT moves.
HLS_FRAGMENT=1.5
HLS_WINDOW=22.5

# === ABR ladder ===
# Off by default: SRS then produces the single rendition it always has. Enabled, the ingest
# vhost stops segmenting and becomes a transcode source, and each rung is republished onto
# ABR_VHOST — a vhost with no transcode block, which is what stops a rung from being
# transcoded again and again. See engines/README.md for the full picture.
#
# ABR_ENABLED, ABR_LADDER and ABR_VHOST are read by the stream-uploader as well as by SRS. SRS's
# webhooks carry a stream name and nothing else, so the geometry and the encoder's target bitrate
# that the master playlist needs are only knowable from this file.
ABR_ENABLED=false

# name:width:height:kbps, space separated. The name becomes the stream-name suffix
# (livestream -> livestream_720p) and is what the uploader groups the ladder by, so keep the
# <height>p form. Widths and heights must be even; H.264 rejects odd ones.
ABR_LADDER=1080p:1920:1080:5000 720p:1280:720:2800 480p:854:480:1200 360p:640:360:700

# ABR_FPS x HLS_FRAGMENT must be a whole number of frames — that product is the GOP, and every
# rung has to place its keyframes at the same media timestamps or a switch lands mid-GOP.
# The entrypoint refuses to start rather than round it. 30 x 1.5 = 45; 25 x 1.5 = 37.5 is not.
ABR_FPS=30
ABR_PRESET=veryfast
# Seconds of VBV buffer, as a multiple of each rung's bitrate. The kbps in ABR_LADDER reaches x264
# as -b:v, an average it is free to overshoot — measured against a 700kbps rung it ran 40% over,
# and every one of those bytes is a chunk a viewer has to retrieve. maxrate plus bufsize makes the
# target a ceiling. 1 is tight, which is what a live ladder wants: a larger buffer lets a complex
# scene borrow bitrate from its neighbours and produces exactly the segment-size spikes that stall
# retrieval. Raise it if quality suffers more than the spikes cost.
ABR_VBV_SECONDS=1
ABR_PROFILE=main
# 0 lets ffmpeg pick. There is one ffmpeg process per rung, each decoding the source
# independently, so four rungs is four decodes — usually the ladder's real CPU floor.
ABR_THREADS=0

# "copy" keeps the publisher's AAC track bit-identical across all four rungs, which costs no CPU
# and removes cross-rung A/V drift. Switch to "aac" if the publisher sends something else.
# Audio is muxed into every rung for the POC rather than split into its own rendition group.
ABR_ACODEC=copy
ABR_AUDIO_BITRATE=128

# The vhost the rungs are republished onto, and the RTMP port to reach it on. Deliberately not
# SRS's [port] variable: ingest here is SRT on 10080, and [port] resolves to the port the source
# arrived on, so the republish would be aimed at the SRT listener (ossrs/srs#4496).
ABR_VHOST=abr
ABR_RTMP_PORT=1935

SRS_SRT_PORT=10080
SRT_PASSPHRASE=

# Webhook target — auto-resolved by deploy.sh for Docker deployment.
# Set manually when running SRS standalone (engines/srs/docker-compose.yml).
SRS_ADAPTER_HOST=localhost
SRS_ADAPTER_PORT=3000


# Where the stream-uploader reads HLS segments written by SRS (local dev).
SRS_MEDIA_PATH=../../engines/srs/media

# BEE_URL is a core uploader setting — set it in the root .env / .env.<profile>.
# In deploy.sh it is auto-resolved from config.json unless explicitly overridden.
