# === Oven Media Engine ===
# Copy to engines/ome/.env — loaded automatically when ENGINE=ome.
# Profile deploys use engines/ome/.env.<profile> (deploy.sh creates it from
# engines/ome/.env on first deploy).
# Also enable the "ome" service in deploy/config.json (disabled by default).
#
# With default values the stream URL would be:
# srt://127.0.0.1:10081?streamid=srt://127.0.0.1:10081/video/test

# Segment length in seconds, and how many the playlist keeps.
# Defaults reproduce the previous hardcoded values.
HLS_SEGMENT_DURATION=2
HLS_SEGMENT_COUNT=5
#
# These two multiply out to the playlist window, and the player's
# DEFAULT_HLS_TUNING.liveSyncDuration (6s) is a latency target clamped to that window. At the
# defaults below the window is 5 x 2s = 10s, so the playhead targets 6s behind live and keeps
# 4s of margin before the eviction boundary. Raising either value is only worthwhile if viewers
# report stalls, not for margin the defaults already have.

# OME_HLS_URL is for native dev (uploader on the host). In Docker deploys it is
# auto-resolved by deploy.sh based on config.json, like BEE_URL.
OME_HLS_URL=http://localhost:8081
OME_HLS_POLL_INTERVAL_MS=500

# Abort window for every HLS request the puller makes. Node's fetch has no default
# timeout, so without this a black-holed connection stalls the poll loop.
OME_FETCH_TIMEOUT_MS=10000

# Host-published ports for the ome service (not shifted by --portSlot —
# override per profile when running multiple OME instances on one host).
OME_SRT_PORT=10081
OME_HLS_PORT=8081

# Shared secret for the admission webhook (OME signs requests with it,
# the stream-uploader verifies the X-OME-Signature header).
# REQUIRED when ENGINE=ome, and left empty here on purpose. setup.sh copies this
# file to engines/ome/.env, so any value committed here becomes the live secret of
# every deployment that never edits it. Generate your own:
#   openssl rand -hex 32
# Until you do, the uploader exits at startup with "Required env var is set but
# empty: OME_ADMISSION_SECRET" instead of admitting unsigned ingest.
OME_ADMISSION_SECRET=

# Allow connections when the admission handler errors (default: false = reject).
OME_ADMISSION_FAIL_OPEN=false
