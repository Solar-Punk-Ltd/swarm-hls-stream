node_modules
dist
.env*

# Batch id written beside .env when stamp:setup cannot record it there (OPS-1)
stamp-batch-*.txt
!.env.sample
.DS_Store
*.log
coverage
.vscode
state/
nodes/data/
nodes/backups/
deploy/data/
deploy/config.json
deploy/.env.deploy*
*.tsbuildinfo

/engines/srs/media

# Compiled output emitted beside sources, which happens when tsc is invoked with
# file names on the command line and so ignores tsconfig.json's outDir.
packages/*/src/**/*.js
packages/*/test/**/*.js

# Stryker copies the whole tree into a sandbox per run and writes its report beside it.
.stryker-tmp/
reports/mutation/

# Frame captures written per run by `e2e/src/browser/runFiles.ts`. `bench-on-host.sh` rsyncs
# `docs/bench/` back wholesale after every run, so anything a harness leaves there is staged
# without anyone choosing to keep it. Each run's own report carries the numbers these show.
docs/bench/browser-screenshots/

# Raw per-run telemetry, one file per run beside the markdown report that summarises it, and
# rsynced back by the same wholesale copy. The reports are the findings and are kept; these are
# roughly 4,500 lines each and are read once, by the analysis that produced the report. A raw
# file worth keeping as evidence is added deliberately with `git add -f`.
docs/bench/latency-*.json
docs/bench/longrun-*.json
docs/bench/browser-watch-*.json
docs/bench/browser-crash-*.json
